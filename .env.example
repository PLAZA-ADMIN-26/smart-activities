# Copia questo file in ".env" per lo sviluppo locale (opzionale) oppure imposta
# le stesse variabili nelle impostazioni del progetto su Vercel
# (Project Settings → Environment Variables).
#
# Senza questa chiave il sito funziona comunque: "Sistema la mia nota" userà
# automaticamente il motore euristico locale invece del vero modello Groq.

# Chiave gratuita da https://console.groq.com/keys (un solo click, nessun
# progetto Cloud da configurare)
GROQ_API_KEY=gsk_...

# Facoltativo: forza un modello diverso se quello di default viene
# deprecato, senza dover toccare il codice. Modelli disponibili su
# https://console.groq.com/docs/models
GROQ_MODEL=llama-3.3-70b-versatile
