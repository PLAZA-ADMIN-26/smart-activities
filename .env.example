# Copia questo file in ".env" per lo sviluppo locale (opzionale) oppure imposta
# le stesse variabili nelle impostazioni del progetto su Vercel
# (Project Settings → Environment Variables).
#
# Senza questa chiave il sito funziona comunque: "Sistema la mia nota" userà
# automaticamente il motore euristico locale invece del vero modello Gemini.

# Chiave gratuita da https://aistudio.google.com (sezione "Get API key")
GEMINI_API_KEY=AIza...

# Facoltativo: forza un modello diverso se Google rinomina/deprecare quello
# di default, senza dover toccare il codice. Verifica i nomi aggiornati su
# https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-2.0-flash
